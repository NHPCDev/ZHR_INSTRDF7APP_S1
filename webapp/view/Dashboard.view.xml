<mvc:View
    controllerName="com.nhpc.zhrinstrdf7apps1.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    class="sapUiSizeCompact"
>
    <f:DynamicPage
        id="_IDGenDynamicPage1"
        headerExpanded="true"
        showFooter="true"
    >
        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader1">
                <f:content>
                    <fb:FilterBar
                        id="filterbar"
                        persistencyKey="myPersKey"
                        useToolbar="false"
                        search=".onSearchBtn"
                    >
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                id="_IDGenFilterGroupItem1"
                                name="ApplicationNo"
                                label="{i18n>applicationNo}"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <Input
                                        id="appNo"
                                        value="{viewModel>/filterData/ApplicationNo}"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                id="_IDGenFilterGroupItem4"
                                name="EmployeeNumber"
                                label="{i18n>employeeID}"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <Input
                                        id="EmployeeNumber"
                                        value="{viewModel>/filterData/Pernr}"
                                        showValueHelp="true"
                                        app:valuehelp="EmployeeNumber"
                                        valueHelpRequest="onValueHelpRequest"
                                        change="onValueHelpChange"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                id="_IDGenFilterGroupItem2"
                                name="ConfirmedOn"
                                label="{i18n>confirmedOn}"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <DatePicker
                                        id="idConfirmedOn"
                                        value="{viewModel>/filterData/ConfirmedOn}"
                                        displayFormat="dd.MM.yyyy"
                                        valueFormat="yyyyMMdd"
                                        change="onDateChange"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox id="_IDGenVBox1">
                <Table
                    id="idDashboardTable"
                    items="{
                        path: '/PreapprovedSet',
                        filters: [
                            {
                                path: 'ApproverFlag',
                                operator: 'EQ',
                                value1: '7'
                            }
                        ]
                    }"
                    growing="true"
                    growingThreshold="20"
                    width="100%"
                    mode="None"
                    autoPopinMode="true"
                    alternateRowColors="true"
                    sticky="ColumnHeaders,HeaderToolbar,InfoToolbar"
                    updateFinished="onDashboardTableUpdateFinish"
                >
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title
                                id="dashBoardTitle"
                                text="{= ${i18n>dashboardTableTitle} + ' (' + (${/HeaderSet} ? ${/HeaderSet}.length : 0) + ')' }"
                            />
                            <ToolbarSpacer />
                            <Button
                                text="{i18n>downloadReportBtnText}"
                                press="onDownload"
                                type="Reject"
                                icon="sap-icon://excel-attachment"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column>
                            <Text text="{i18n>applicationNo}" />
                        </Column>

                        <Column>
                            <Text text="{i18n>employeeID}" />
                        </Column>

                        <Column>
                            <Text text="{i18n>confirmedOn}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>status}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press="onListItemPress"
                        >
                            <cells>
                            <ObjectIdentifier title="{ApplicationNo}"></ObjectIdentifier>
                                <ObjectIdentifier title="{Pernr}" text="{EmployeeName}" />
                                <Text
                                    text="{
                                        path: 'ConfirmedOn',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: {
                                            source: {
                                                pattern: 'dd.MM.yyyy'
                                            },
                                            pattern: 'dd.MM.yyyy'
                                        }
                                }"
                                />
                                <ObjectStatus
                                    text="{path:'Status',formatter:'.formatter.formatTitleCase'}"
                                    class="sapMObjectStatusMedium statusBoldText"
                                    state="{path:'Status',formatter:'.formatter.formatStatusState'}"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
