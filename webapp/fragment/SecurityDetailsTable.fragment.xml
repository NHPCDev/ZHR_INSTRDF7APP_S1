<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    class="sapUiSizeCompact"
>
    <VBox>
        <Toolbar>
            <Title
                text="{= ${i18n>tableTitle} + ' (' + ${viewModel>/tableLength} + ')' }"
            />
            <ToolbarSpacer />
            <Button
                text="{i18n>addBtnText}"
                icon="sap-icon://add"
                type="Accept"
                press="onAddSecurityDetails"
                visible="false"
            />
            <Button
                text="{i18n>deleteBtnText}"
                icon="sap-icon://delete"
                type="Reject"
                press="onDeleteSecurityDetails"
                visible="false"
            />
            <Button
                text="{i18n>editBtnText}"
                icon="sap-icon://edit"
                type="Emphasized"
                press="onEditSecurityDetails"
                visible="false"
            />
        </Toolbar>
        <Table
            id="idSecurityTable"
            items="{viewModel>/tableData}"
            mode="None"
            updateFinished="onTableUpdateFinish"
        >
            <columns>
                <Column>
                    <Text text="{i18n>nameOfTheHolder}" />
                </Column>
                <Column>
                    <Text text="{i18n>numberOfSecurities}" />
                </Column>
                <Column>
                    <Text text="{i18n>bought/sold/subscribed}" />
                </Column>
                <Column>
                    <Text text="{i18n>dpIdClientId}" />
                </Column>
                <Column>
                    <Text text="{i18n>price}" />
                </Column>
                <Column >
                    <Text text="{i18n>transactionDate}"></Text>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{viewModel>HolderName}" />
                        <Text text="{path:'viewModel>NoOfSecurities',formatter:'.formatter.formatNumbers'}" />
                        <Text text="{viewModel>TransactionType}" />
                        <Text text="{viewModel>DPClientID}" />
                        <Text text="{path:'viewModel>Price',formatter:'.formatter.formatAmountToINR'}" />
                        <Text text="{path:'viewModel>TransactionDate', formatter:'.formatter.formatDate'}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>
